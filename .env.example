# MeowSync 环境配置文件
# 复制此文件为 .env 并根据实际部署环境修改配置
# 注意：VITE_* 变量在构建期注入前端代码，修改后需重新构建

# ===================
# 前端配置
# ===================

# 前端开发服务器端口
VITE_PORT=3100

# 前端开发服务器绑定地址（独立于后端 HOST）
# VITE_HOST=localhost

# API服务器地址（可选覆盖；默认留空 = 自动推断）
# 开发环境自动推断为 当前主机:VITE_API_PORT；生产单进程/反代部署自动走同源。
# 注意：该值会打包进前端产物（Docker 构建经 build args 注入），
# 仅在 API 与前端页面分离部署时才需要显式配置
# VITE_API_BASE_URL=http://localhost:3101

# API服务器端口（未配置 VITE_API_BASE_URL 时的回退端口）
VITE_API_PORT=3101

# API请求超时时间（毫秒）
VITE_API_TIMEOUT=10000

# 应用基础路径（用于子目录部署）
VITE_BASE_PATH=/

# 是否自动打开浏览器（Linux服务器建议设为false）
VITE_OPEN_BROWSER=true

# 允许访问的域名列表（逗号分隔，用于开发环境安全配置）
# VITE_ALLOWED_HOSTS=example.com,another-domain.com

# 远程遥控令牌（与后端 REMOTE_TOKEN 配对；后端设置了 REMOTE_TOKEN 时前端必须提供相同值）
# VITE_REMOTE_TOKEN=
# 下载接口令牌（与后端 DOWNLOAD_TOKEN 配对；后端设置了 DOWNLOAD_TOKEN 时前端必须提供相同值。
# docker compose 部署无需此变量——构建 arg 会自动回落到 DOWNLOAD_TOKEN）
# VITE_DOWNLOAD_TOKEN=

# ===================
# 后端配置
# ===================

# API服务器端口
API_PORT=3101

# 端口备用变量：仅当 API_PORT 未设置时生效（Heroku/Railway 等 PaaS 平台会自动注入 PORT）
# PORT=3101

# 服务器绑定地址（0.0.0.0 监听所有接口，局域网访问/容器部署用；仅本机访问可改 127.0.0.1）
HOST=0.0.0.0

# 允许的跨域来源（多个用逗号分隔；同时也是 WebSocket 遥控的 Origin 白名单）
CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

# 生产环境跨域配置示例:
# CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# 远程遥控访问令牌（可选；设置后客户端须携带令牌连接 /remote——子协议通道优先，
# ?token= 仅兼容兜底。未设置时任何能访问本服务的客户端都可接管主机端，
# 公网/共享网络部署务必配置；局域网自信任环境可留空）
# REMOTE_TOKEN=
# 下载/歌单/歌词校准/AI 写接口令牌（非必需；设置后非 GET 的 /downloads、/playlists、
# /song-meta、/ai 请求须带 x-download-token 头。公网部署启用 AI 时强烈建议设置——
# AI 调用真实消耗上游配额）
# DOWNLOAD_TOKEN=

# 是否信任反向代理头 X-Forwarded-Proto/Host（仅部署在会改写 Host 的代理后时设为 1）
# TRUST_PROXY=

# 数据目录（SQLite 数据库与下载文件的存放根目录；默认 <项目根>/data）
# DATA_DIR=./data

# 下载文件目录（默认 <DATA_DIR>/downloads；Docker 部署指到挂载卷路径）
# DOWNLOAD_DIR=

# 部署环境 (development, production)
NODE_ENV=development

# ── AI 辅助（可选，OpenAI 兼容接口）────────────────────────────
# 三项全配才启用；任一缺失则全部 AI 功能静默停用（不影响现有行为）。
# 接入点：歌曲解锁的检索元数据规整、B 站/YouTube 导入的网易云匹配复核与兜底、
# 外部导入曲歌词归属核验、无官方译文歌词的自动中文翻译（结果按词源 id 落库缓存）。
# AI_BASE_URL=http://127.0.0.1:8317/v1     # 本地 CLIProxyAPI/one-api/new-api
# AI_API_KEY=your-key
# AI_MODEL=deepseek-v4.1-flash
# AI_TIMEOUT_MS=30000                       # 单次 AI 请求超时

# B 站登录 Cookie（可选）：形如 "SESSDATA=xxx; bili_jct=yyy"（建议导完整串含 buvid3）。
# 杜比全景声/Hi-Res 无损音轨只对登录账号下发（Hi-Res 通常需大会员），
# 不配则这些轨道不可见，下载自动回落到最高码率常规 AAC。
# CURRENT_FNVAL 由服务端按请求自动重写（4048），不用手工带。
# 仅用于 api.bilibili.com 请求头，不出进程。
# BILI_COOKIE=

# QQ 音乐登录 Cookie（可选）：形如 "uin=o123456; qm_keyst=xxx"（或 qqmusic_key）。
# 无损/Hi-Res 与 VIP 档只对登录账号下发，不配则匿名态只有常规档（免费曲可播、
# VIP 曲 104003 无权限）。同时会作为网易云灰曲的解锁兜底源之一。
# ⚠️ 务必用小号——腾讯对第三方调用的账号风控有明确先例；cookie 仅用于
# *.qq.com API 请求，不出进程、不进代理链。
# QQ_COOKIE=
